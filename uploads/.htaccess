# Uploaded files are images only: never execute scripts here
Options -Indexes
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
AddType text/plain .php .phtml .phar
